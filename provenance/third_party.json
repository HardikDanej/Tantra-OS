{
  "version": 1,
  "description": "Paths excluded from Hardik Danej's Tantra Seal (OS manifest, frontmatter CMI, OS fingerprint registration). Third-party work keeps its own licence and is never signed as the owner's; generated and runtime files change on every build, so sealing them would only produce noise. Patterns are repo-relative, forward slashes, gitignore-style (** = any depth).",
  "exclude": [
    {"pattern": ".claude/skills/unlazy/**", "reason": "third-party", "license": "MIT, Copyright (c) 2026 Leonxlnx; see .claude/skills/unlazy/LICENSE"},
    {"pattern": "**/node_modules/**", "reason": "third-party", "license": "each package's own licence"},
    {"pattern": "**/package-lock.json", "reason": "generated", "license": null},
    {"pattern": "**/__pycache__/**", "reason": "generated", "license": null},
    {"pattern": "**/*.pyc", "reason": "generated", "license": null},
    {"pattern": ".claude/hooks/tantra_registry.json", "reason": "generated by tools/build_tantra_registry.py", "license": null},
    {"pattern": "taxonomy/marketing_taxonomy.json", "reason": "generated by .claude/lib/taxonomy_registry.py", "license": null},
    {"pattern": "version-manifest/manifest.json", "reason": "generated by .claude/lib/version_manifest.py", "license": null},
    {"pattern": "evals/results/**", "reason": "runtime output", "license": null},
    {"pattern": "**/*.tantra.bak", "reason": "runtime backup", "license": null}
  ]
}
